# ============================================================
# YOLO OBB Geo API Server - 环境变量配置
# 复制此文件为 .env 并按需修改:  cp .env.example .env
# ============================================================

# --- 模型 ---
MODEL_PATH=yolo26n_obb_fair1m.pt
IMG_SIZE=1024

# --- 推理阈值 ---
OBJ_THRESH=0.25
NMS_THRESH=0.45

# --- 请求限制 ---
REQUEST_TIMEOUT_SEC=30
MAX_IMAGE_BYTES=104857600
MAX_PIXELS=100000000

# --- 返回图像 ---
# none | base64 | binary
RETURN_IMAGE_MODE=none

# --- 异步任务 ---
ASYNC_WORKERS=1

# --- 鉴权 (留空=不鉴权) ---
API_KEY=

# --- 异步任务 GC ---
# 终态 (succeeded/failed) 任务在内存中保留的秒数；超时后由后台线程清掉
JOB_TTL_SEC=3600
# GC 线程扫描间隔（秒）
JOB_GC_INTERVAL_SEC=60
